    "dev:macos": "bash scripts/macos/dev.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "dompurify": "^3",
    "echarts": "^6.1.0",
    "fast-json-patch": "^3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468",
    "marked": "^16",
    "mermaid": "^12.3.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^30.1.3",
    "vite": "^7"
  }
}
