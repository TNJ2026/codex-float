{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Float",
  "version": "0.1.0",
  "identifier": "local.codex.float.demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Float",
        "width": 450,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "theme": "Light",
        "alwaysOnTop": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http: asset:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*.[pP][nN][gG]",
            "**/*.[jJ][pP][gG]",
            "**/*.[jJ][pP][eE][gG]",
            "**/*.[gG][iI][fF]",
            "**/*.[wW][eE][bB][pP]",
            "**/*.[bB][mM][pP]",
            "**/*.[sS][vV][gG]",
            "**/*.[aA][vV][iI][fF]",
            "**/*.[iI][cC][oO]"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
